# Smart Vision Sentry — Environment Variables Template

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# Backend Environment Variables (FastAPI)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
HIKVISION_HOST=192.168.1.104
HIKVISION_RTSP_PORT=554
HIKVISION_USERNAME=your_camera_username
HIKVISION_PASSWORD=your_camera_password
HIKVISION_CHANNEL=101
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
