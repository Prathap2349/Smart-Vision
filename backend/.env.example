# Smart Vision Sentry — Environment Variables Template

# ==========================================
# 1. Frontend Environment Variables (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional static API key sent as X-API-Key / ?api_key= when not using Supabase JWT
VITE_API_KEY=

# ==========================================
# 2. Backend Security & Auth Hardening
# ==========================================
# DEV_MODE=true bypasses auth for local development and automated tests.
# Set DEV_MODE=false in production to require a valid Supabase JWT or X-API-Key.
DEV_MODE=true
API_KEY=change_me_for_production_api_access
SUPABASE_JWT_SECRET=your_supabase_jwt_signing_key
CAMERA_SECRET=your_32_byte_base64_fernet_key_or_passphrase
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Upload & WebSocket Rate / Size Limits
MAX_ENROLLMENT_PHOTOS=10
MAX_ENROLLMENT_IMAGE_BYTES=5242880
ENROLLMENT_RATE_LIMIT_PER_MIN=10
MAX_WS_FRAME_BYTES=2097152

# ==========================================
# 3. Cloud Sync, Camera & Alert Integrations
# ==========================================
SUPABASE_URL=
SUPABASE_KEY=
HIKVISION_HOST=192.168.1.104
HIKVISION_RTSP_PORT=554
HIKVISION_USERNAME=your_camera_username
HIKVISION_PASSWORD=your_camera_password
HIKVISION_CHANNEL=101
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_UNVERIFIED_FACE=true
