# Backend-only environment template. Copy to backend/.env and replace values.
DEV_MODE=true
API_KEY=
SUPABASE_JWT_SECRET=
CAMERA_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

DATA_DIR=
MODELS_DIR=
TIMEZONE=Asia/Kolkata

SUPABASE_URL=
SUPABASE_KEY=

HIKVISION_HOST=
HIKVISION_RTSP_PORT=554
HIKVISION_USERNAME=
HIKVISION_PASSWORD=
HIKVISION_CHANNEL=101

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_UNVERIFIED_FACE=true

MAX_ENROLLMENT_PHOTOS=10
MAX_ENROLLMENT_IMAGE_BYTES=5242880
ENROLLMENT_RATE_LIMIT_PER_MIN=10
MAX_WS_FRAME_BYTES=2097152
DETECTOR_CONFIDENCE_THRESHOLD=0.65
GATE_HUMAN_CONFIDENCE_THRESHOLD=0.70
FACE_SIMILARITY_THRESHOLD=0.50
