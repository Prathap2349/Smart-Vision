# Smart Vision Sentry Environment Variables

# Supabase Project Credentials (Optional Cloud Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Telegram Bot Alert Credentials (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Hikvision Camera Configuration
HIKVISION_HOST=192.168.1.104
HIKVISION_RTSP_PORT=554
HIKVISION_USERNAME=your_camera_username
HIKVISION_PASSWORD=your_camera_password
HIKVISION_CHANNEL=101

